// ============================================================
// 杯标 (cup tag) — 按 cup_tag.stl 复刻
// ------------------------------------------------------------
// 坐标：圆盘圆心 = (0, 0)，+Z = 顶面（阴刻面），底面 z = 0
// 外形：直径 25 (R12.5)，厚 3；右侧平切边 x ≈ +9.03（原模型实测）
//       夹子为原模型同款 J 形钩；整体为同一厚度的拉伸体
// 图案：默认读取同目录的“图案-星形.svg”，在顶面阴刻 0.8 mm
//       替换 SVG 即可定制；也可调位置/比例/旋转/镜像
// 参数集中在文件末尾
// ============================================================

module tag_profile_2d() {
    polygon(points = OUTER_PROFILE);
}

module pattern_source_2d() {
    if (PATTERN_FIT_WIDTH > 0) {
        // 只按宽度等比缩放，高度自动跟随，适合尺寸未知的第三方 SVG
        resize([PATTERN_FIT_WIDTH, 0], auto = true)
            import(PATTERN_SVG, center = true, convexity = 10);
    } else {
        // SVG 自带 mm 物理尺寸时，PATTERN_SCALE = 1 即 1:1
        scale(PATTERN_SCALE)
            import(PATTERN_SVG, center = true, convexity = 10);
    }
}

module engraving_2d() {
    translate([PATTERN_CENTER[0], PATTERN_CENTER[1]])
        rotate([0, 0, PATTERN_ROT])
            scale([PATTERN_MIRROR ? -1 : 1, 1])
                pattern_source_2d();
}

module cup_tag() {
    assert(TAG_THICKNESS > 0, "TAG_THICKNESS 必须大于 0");
    assert(ENGRAVE_DEPTH >= 0 && ENGRAVE_DEPTH < TAG_THICKNESS,
           "ENGRAVE_DEPTH 必须 >= 0 且 < TAG_THICKNESS");
    difference() {
        linear_extrude(height = TAG_THICKNESS, convexity = 10)
            tag_profile_2d();
        if (ENGRAVE_PATTERN && ENGRAVE_DEPTH > 0) {
            // 刀具从凹槽底面 (z = T - d) 向上超出顶面，保证顶面开口干净
            translate([0, 0, TAG_THICKNESS - ENGRAVE_DEPTH])
                linear_extrude(height = ENGRAVE_DEPTH + 0.4, convexity = 10)
                    engraving_2d();
        }
    }
}

cup_tag();

// ====================== 可调参数 ======================
TAG_THICKNESS   = 3.0;    // 总厚度
ENGRAVE_DEPTH   = 0.8;    // 图案阴刻深度（剩余底厚 = 3 - 0.8 = 2.2）
ENGRAVE_PATTERN = true;   // false = 不刻图案

// SVG 图案：
//  · 以 mm 指定 width/height 的 SVG 按实际尺寸导入；PATTERN_SCALE 再做整体缩放。
//  · 若不想算比例，把 PATTERN_FIT_WIDTH 设为想要的宽度(mm)，会等比缩放（此时忽略 PATTERN_SCALE）。
//  · OpenSCAD 只按 SVG 的填充轮廓挖槽，不认描边；文字请先转曲，线稿请转成填充区域。
//  · 背景矩形/边框/水印会一并被刻掉，导入前请删掉。
//  · 图形内部的孔洞（evenodd 多子路径）会保留为中心岛。
PATTERN_SVG        = "图案-星形.svg";
PATTERN_SCALE      = 1.0;
PATTERN_FIT_WIDTH  = 0;      // >0：按该宽度等比缩放；0 = 使用 PATTERN_SCALE
PATTERN_CENTER     = [-1.178574, 0.670566]; // 图案外接框中心（相对圆盘圆心）
PATTERN_ROT        = 0;      // 绕图案中心旋转（度）
PATTERN_MIRROR     = false;  // true = 左右镜像（刻字时注意可读性）

