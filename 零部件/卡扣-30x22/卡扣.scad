// 卡扣（30 × 22 × 2.5）
// ────────────────────────────────────────────────────────────────
// 按手绘尺寸图 + 实物照片复刻的平板卡扣：
//   • 外形 30 × 22，厚 2.5；顶部两角 2mm 倒角（照片可见，可用 TOP_CH 关掉）；
//   • 中间竖直开槽：宽 9，槽顶距底边 17（即距顶边 5），底端开口、贯通厚度；
//   • 槽顶正中向下伸出一条舌片（卡钩）：宽 5、长 4.5，端部两角 1mm 倒角；
//   • 槽口下端两侧各向外扩 2mm（扩口高 3mm），形成引导用的喇叭口。
//
// 坐标：正视图中 x 向右、y 向上，外形左下角在 (0,0)；厚度沿 +Z 拉伸。
// 参数集中在文件末尾。
// ────────────────────────────────────────────────────────────────

module latch_profile() {
    // 单一闭合轮廓：外框 + 底端开口的竖槽 + 槽顶下垂的舌片
    polygon(points = [
        [0, 0],                             // 左下角
        [MOUTH_L, 0],                       // 底边 → 左侧扩口起点
        [SLOT_X0, FLARE_H],                 // 左侧扩口斜边
        [SLOT_X0, SLOT_TOP],                // 槽左侧壁
        [TAB_X0, SLOT_TOP],                 // 槽顶左段
        [TAB_X0, TAB_BOT + TAB_CH],         // 舌片左侧
        [TAB_X0 + TAB_CH, TAB_BOT],         // 舌片左下倒角
        [TAB_X1 - TAB_CH, TAB_BOT],         // 舌片底边
        [TAB_X1, TAB_BOT + TAB_CH],         // 舌片右下倒角
        [TAB_X1, SLOT_TOP],                 // 舌片右侧
        [SLOT_X1, SLOT_TOP],                // 槽顶右段
        [SLOT_X1, FLARE_H],                 // 槽右侧壁
        [MOUTH_R, 0],                       // 右侧扩口斜边
        [W, 0],                             // 右下角
        [W, H - TOP_CH],                    // 右边
        [W - TOP_CH, H],                    // 右上倒角
        [TOP_CH, H],                        // 顶边
        [0, H - TOP_CH]                     // 左上倒角
    ]);
}

linear_extrude(height = T)
    latch_profile();

// ═══════════════════ 参数（集中在文件末尾）═══════════════════
W = 30;             // 外形宽
H = 22;             // 外形高
T = 2.5;            // 厚度

SLOT_W = 9;         // 中央竖槽宽
SLOT_TOP = 17;      // 竖槽顶到底边的距离（顶部实心边 = H - SLOT_TOP = 5）
TAB_W = 5;          // 舌片宽
TAB_LEN = 4.5;      // 舌片长（从槽顶往下量，对应图中 4.5）
TAB_CH = 1;         // 舌片端部两角 45° 倒角

FLARE = 2;          // 槽口底端每侧外扩量（底口宽 = SLOT_W + 2*FLARE = 13）
FLARE_H = 3;        // 扩口段高度
TOP_CH = 2;         // 外形顶部两角 45° 倒角（照片有此倒角；设 0 恢复直角）

// ───────── 派生量（必须写在上面参数之后）─────────
SLOT_X0 = (W - SLOT_W) / 2;
SLOT_X1 = (W + SLOT_W) / 2;
TAB_X0 = (W - TAB_W) / 2;
TAB_X1 = (W + TAB_W) / 2;
TAB_BOT = SLOT_TOP - TAB_LEN;
MOUTH_L = SLOT_X0 - FLARE;
MOUTH_R = SLOT_X1 + FLARE;
