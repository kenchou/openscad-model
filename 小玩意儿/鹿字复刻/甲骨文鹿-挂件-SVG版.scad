// 孔心：外接框比例 → SVG 坐标 → 成品坐标（含 y 翻转、居中、拉伸、整体缩放）
HOLE_SVG_X = SVG_X0 + RING_HOLE_UV[0] * SVG_BBOX_W;
HOLE_SVG_Y = SVG_Y0 + RING_HOLE_UV[1] * SVG_BBOX_H;
HOLE_X = (HOLE_SVG_X - SVG_CX) * STRETCH_X * S;
HOLE_Y = (SVG_CY - HOLE_SVG_Y) * STRETCH_Y * S;

if (EXTRUDE > 0)
    difference() {
        linear_extrude(height = EXTRUDE, $fn = 24) placed();
        if (RING_HOLE_ON)
            // 孔深受限：只钻穿颈部这一块料，不会误伤远处的笔画
            translate([HOLE_X, HOLE_Y, EXTRUDE / 2])
                rotate([0, 90, 0])                       // 圆柱轴 Z → X（垂直于 Z）
                    rotate([0, 0, RING_HOLE_ROT])
                        cylinder(d = RING_HOLE_D_MM, h = RING_HOLE_DEPTH,
                                 center = true, $fn = RING_HOLE_FN);
    }
else
    // 2D 模式：为了让孔位可见，按孔径挖一个圆作"位置标记"。
    // 注意这只是指示孔心/孔径；真实挂件里它是**垂直于 Z 轴的横向孔**（见上面的 3D 分支）。
    difference() {
        placed();
        if (RING_HOLE_ON)
            translate([HOLE_X, HOLE_Y]) circle(d = RING_HOLE_D_MM, $fn = 48);
    }
