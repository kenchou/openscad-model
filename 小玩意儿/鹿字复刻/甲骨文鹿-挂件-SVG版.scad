// ============================================================================
//  甲骨文「鹿」字形 —— 挂件 / 冰箱贴 / 激光切割用 2D 轮廓（SVG 形状版）
//  ---------------------------------------------------------------------------
//  形状来源：用户自己从原图描出的 SVG（/Users/ken/Downloads/甲骨文-鹿.svg，
//            viewBox 0 0 362 662），外轮廓 1261 点 + 4 个镂空，全部为三次贝塞尔采样点。
//  本版**不再使用照片自动提取的轮廓** —— 之前那套"正面提取 + 平滑"虽然能出形状，
//  但与用户描的基准偏差较大，现以用户 SVG 为唯一形状基准。
//
//  ★ 关于"拉宽"：原物是略微侧转着拍的，投影会把横向压短（透视缩短）。
//    所以横向应当比描出来的 SVG 再拉开一点。用 STRETCH_X 调：
//      STRETCH_X = 1.00 → 与 SVG 完全一致
//      STRETCH_X = 1.10 → 横向拉宽 10%（默认，补偿侧转）
//    纵向同理可用 STRETCH_Y 微调；两者都以形状中心为基准缩放，不会跑偏。
//
//  用法：
//    EXTRUDE = 3 → 出 3mm 厚挂件实体（默认；挂孔是真孔，可在 3D 预览里直接看）
//    EXTRUDE = 0 → 只出 2D 轮廓（激光切割导 DXF/SVG）；此时孔只作"位置标记"挖一个圆
//    TARGET_H    → 成品高度 mm（按拉伸后的高度换算，改这一个数即可整体缩放）
//    RING_HOLE_ON→ 是否需要顶部穿绳孔（孔轴垂直于 Z 轴，横穿颈部）
// ============================================================================

module lu_gu() {
    difference() {
        polygon(OUTER);
        for (h = HOLES) polygon(h);          // 4 处镂空（目、角间空隙等）
    }
}

// SVG 坐标(y 向下) → OpenSCAD(y 向上)，再按中心拉伸、缩放到成品高度
module placed() {
    s = TARGET_H / (SVG_BBOX_H * STRETCH_Y);
    scale(s)
        scale([STRETCH_X, STRETCH_Y])
            translate([-SVG_CX, -(SVG_H - SVG_CY)])
                translate([0, SVG_H]) scale([1, -1]) lu_gu();
}


// ============================== 参数区 ======================================
// 本项目约定：所有可调参数集中在文件末尾（顶层赋值必须写在参数之后！）

EXTRUDE      = 3;        // ★3 = 3mm 厚实体（默认，打开就能看到挂孔）
                         //   0 = 只出 2D 轮廓（给激光切割导 DXF/SVG 用）
TARGET_H     = 68;       // 成品高度（mm）
STRETCH_X    = 1.10;     // ★横向拉伸：1.00 = 与 SVG 相同；>1 拉宽（补偿原图侧转）
STRETCH_Y    = 1.00;     // ★纵向拉伸：一般保持 1.00
CENTER       = true;     // 预留：是否把成品中心移到原点（当前 placed() 已居中）

// --- 顶部穿绳孔（孔轴垂直于 Z 轴，在板面内横穿颈部）---
//  ★孔位用"相对形状外接框的比例"给，最好理解★：
//    RING_HOLE_UV = [u, v]；u: 0=最左 1=最右；v: 0=最顶端 1=最底端。
//    形状最顶端 = 右侧那支鹿角的尖（y 最小处）。那支角在距顶 6mm 以内只有
//    1.5~2.4mm 宽，打不下孔；往下到"两支合并"处（距顶约 5.8mm）才有 5.1mm 宽。
//    所以默认孔位取在合并处：u=0.739, v=0.096（约距顶端 6.6mm），孔径 1.8mm。
RING_HOLE_ON    = true;
RING_HOLE_UV    = [0.5, 0.042];  // ★孔心位置（外接框比例）
RING_HOLE_D_MM  = 1.8;             // ★孔径（mm，按成品尺寸直接给）
RING_HOLE_DEPTH = 20;              // ★孔深（mm）—— 够穿透该处料厚即可。
                                   //   ★别给很大★：圆柱沿 X 一路穿过去会把远处笔画也钻出孔（曾出现两个孔）
RING_HOLE_FN    = 6;               // 6 = 六角孔（便于 FDM 打印，顶部收成尖角可自支撑）；48 = 圆孔
RING_HOLE_ROT   = 0;               // 六角孔绕孔轴自转角(°)：
                                   //   0  = 尖头朝 +Z（板平放打印时的"上"，默认）
                                   //   30 = 尖头朝 ±Y、顶部变成平边（需要桥接）

// --- SVG 基准常量（来自 /Users/ken/Downloads/甲骨文-鹿.svg）---
